# Swift / SPM
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.xcuserstate

# macOS
.DS_Store

# Feature-workflow scratchpad (working memory, not history)
.claude/scratchpad/

# Build output / signing
*.app
*.dmg
*.pkg
build/

# Local enrollment data should NEVER be committed (it lives in Keychain/encrypted store anyway)
*.embeddings

# Core ML face model binary (ND-021 / ADR-0014): the 45MB model blob is kept OUT of git
# to avoid permanent history bloat and for distribution hygiene (privacy app). It is
# reproduced deterministically from Resources/Models/convert_facenet.py — see
# Resources/Models/README.md. The compiled .mlmodelc lives only inside the built .app.
Resources/Models/*.mlpackage
Resources/Models/*.mlmodel
Resources/Models/*.mlmodelc

# Docs site tooling
.venv/
__pycache__/
# NOTE: site/ is intentionally NOT ignored — the generated docs site is committed
# so it can be read offline with no build step (see ADR-0005).

# Face photos for FaceScore threshold studies (ND-105 / ND-056). Other people's faces
# must NEVER be committed (privacy hard requirement). Convention: put photos in
# face-data/<person>/ at the repo root; faces/ is ignored as an alias. Scoped to these
# directories on purpose — docs/ images are NOT blanket-ignored.
/face-data/
/faces/
